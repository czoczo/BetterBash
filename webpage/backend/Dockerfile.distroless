# Docker image definition

FROM golang:1.24-bookworm as go-build

WORKDIR /go/src/app

COPY ./*go .

RUN go mod init bbb && \
  go mod tidy && \
  CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -o /bbb .

# final image
FROM gcr.io/distroless/static-debian12:nonroot

USER nonroot:nonroot

WORKDIR /app

# Production is the default of the binary as well; spelling it out keeps a
# container started with an inherited APP_ENV from accidentally coming up as a
# development instance.
ENV APP_ENV=production

COPY --chown=nonroot:nonroot --from=go-build /bbb /app/

ENTRYPOINT ["./bbb"]
