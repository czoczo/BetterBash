# Development endpoints, used by `pnpm dev`, `pnpm build:dev` and by `./dev.sh`.
#
# ./dev.sh stages the installer files into public/ of this app, so the dev server
# serves them and the curl / wget install commands download from the dev server
# itself, exactly like they download from the Pages deployment in production.

VITE_BB_ENV=development

# Dev server port, kept in sync with VITE_BB_INSTALL_BASE_URL below.
VITE_BB_SITE_PORT=5173

# Stated explicitly for a development build, and equal to the dev server origin,
# so that a `pnpm build:dev` bundle is recognisable as a local one.
VITE_BB_INSTALL_BASE_URL=http://localhost:5173

# The openssl variant writes its HTTP request by hand and insists on TLS, which
# the dev server does not speak. ./dev.sh starts a small HTTPS file server for
# it, serving the same staged files.
VITE_BB_TLS_BASE_URL=https://localhost:8443

# Interface the dev server listens on and the host names it answers for, both
# set by ./dev.sh (0.0.0.0 there). Left to localhost here, so a plain `pnpm dev`
# does not expose the machine.
# VITE_BB_SITE_HOST=0.0.0.0
# VITE_BB_SITE_ALLOWED_HOSTS=bb-dev.local
