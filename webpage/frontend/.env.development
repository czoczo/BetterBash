# Development endpoints, used by `pnpm dev`, `pnpm build:dev` and by `./dev.sh`.
# They match the listeners of the local backend (webpage/backend, APP_ENV=development).

VITE_BB_ENV=development

# Plain HTTP listener of the local backend (curl / wget methods).
VITE_BB_INSTALL_BASE_URL=http://localhost:8081

# Self-signed HTTPS listener of the local backend (openssl method).
VITE_BB_TLS_HOST=localhost
VITE_BB_TLS_PORT=8443

# Dev server port; keep in sync with VITE_BB_SITE_URL above.
VITE_BB_SITE_PORT=5173

VITE_BB_SITE_URL=http://localhost:5173

# Interface the dev server listens on and the host clients announce, both set by
# ./dev.sh (0.0.0.0 there). Left to localhost here, so `pnpm dev` on its own does
# not expose the machine.
# VITE_BB_SITE_HOST=0.0.0.0
# VITE_BB_SITE_ALLOWED_HOSTS=bb-dev.local
