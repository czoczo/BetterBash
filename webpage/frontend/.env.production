# Production endpoints (default mode of `pnpm build`).
# Kept in version control on purpose: these are the published install commands.

VITE_BB_ENV=production

# Where the bb.tgz package the install commands fetch is served from. Left empty
# deliberately: the WebUI and the package are one Pages deployment, so every
# domain of it - betterbash.cz0.cz and bb.cz0.cz - installs from itself. Set it
# to name another origin instead, for example a repository mirror.
VITE_BB_INSTALL_BASE_URL=

# The git tree the git method clones, pinned to the tag in VERSION_APP.txt. Set
# it only to point the method at a fork.
# VITE_BB_REPO_URL=https://github.com/you/BetterBash

# Origin for the openssl variant, which writes its HTTP request by hand. It
# defaults to the serving origin, which is HTTPS on GitHub Pages.
VITE_BB_TLS_BASE_URL=
