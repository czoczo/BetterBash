# Production endpoints (default mode of `pnpm build`).
# Kept in version control on purpose: these are the published install commands.

VITE_BB_ENV=production

# curl / wget download from the public short domain.
VITE_BB_INSTALL_BASE_URL=https://bb.cz0.cz

# openssl sends a raw HTTP request and has to address the app service itself.
VITE_BB_TLS_HOST=bbb-f4hxb4escnacbpe6.westeurope-01.azurewebsites.net
VITE_BB_TLS_PORT=443

VITE_BB_SITE_URL=https://betterbash.cz0.cz
